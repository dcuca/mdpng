<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>{{.CSS}}</style>
</head>
<body>
  <div id="frame">
    <div class="window">
      <div class="titlebar">
        <div class="dots">
          <span class="dot dot-red"></span>
          <span class="dot dot-amber"></span>
          <span class="dot dot-green"></span>
        </div>
        {{if .Title}}<div class="title">{{.Title}}</div>{{end}}
      </div>
      <div class="content">
{{.Content}}
      </div>
    </div>
  </div>
</body>
</html>
